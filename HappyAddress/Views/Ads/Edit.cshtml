@model HappyAddress.Models.Ad

@section Styles {
    <link rel="stylesheet" href="~/css/ads.css" />
}

<h2>Редактирование объявления</h2>

<h3>Текущие фото</h3>

@if (Model.Images != null && Model.Images.Count > 0)
{
    foreach (var image in Model.Images)
    {
        <div style="display:inline-block; margin-right:15px; margin-bottom:15px; vertical-align:top;">
            <img src="@image.ImagePath" alt="Фото" width="180" /><br />

            <form asp-controller="Ads" asp-action="DeleteImage" method="post" style="margin-top:5px;">
                <input type="hidden" name="imageId" value="@image.Id" />
                <button type="submit">Удалить фото</button>
            </form>
        </div>
    }
}
else
{
    <p>Фото пока нет.</p>
}

<hr />

<form asp-action="Edit" asp-controller="Ads" method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="All" style="color:red"></div>

    <div>
        <label asp-for="Title">Заголовок</label><br />
        <input asp-for="Title" />
        <span asp-validation-for="Title" style="color:red"></span>
    </div>

    <div>
        <label asp-for="Description">Описание</label><br />
        <textarea asp-for="Description"></textarea>
        <span asp-validation-for="Description" style="color:red"></span>
    </div>

    <div>
        <label asp-for="Price">Цена</label><br />
        <input asp-for="Price" type="number" step="0.01" />
        <span asp-validation-for="Price" style="color:red"></span>
    </div>

    <div>
        <label asp-for="City">Город</label><br />
        <input asp-for="City" />
        <span asp-validation-for="City" style="color:red"></span>
    </div>

    <div>
        <label asp-for="Address">Адрес</label><br />
        <input asp-for="Address" />
        <span asp-validation-for="Address" style="color:red"></span>
    </div>

    <div>
        <label asp-for="DealType">Тип сделки</label><br />
        <select asp-for="DealType">
            <option value="">Выберите</option>
            <option value="Продажа">Продажа</option>
            <option value="Долгосрочная аренда">Долгосрочная аренда</option>
            <option value="Посуточная аренда">Посуточная аренда</option>
        </select>
        <span asp-validation-for="DealType" style="color:red"></span>
    </div>

    <div>
        <label asp-for="PropertyType">Тип недвижимости</label><br />
        <select asp-for="PropertyType">
            <option value="">Выберите</option>
            <option value="Квартира">Квартира</option>
            <option value="Дом">Дом</option>
            <option value="Коттедж">Коттедж</option>
            <option value="Таунхаус">Таунхаус</option>
            <option value="Участок">Участок</option>
            <option value="Гараж">Гараж</option>
        </select>
        <span asp-validation-for="PropertyType" style="color:red"></span>
    </div>

    <hr />

    <div>
        <label>Добавить новые фото</label><br />
        <input type="file" name="imageFiles" accept=".jpg,.jpeg,.png" multiple />
    </div>

    <div class="form-group">
        <label asp-for="PhoneNumber">Телефон</label>
        <input asp-for="PhoneNumber" />
        <span asp-validation-for="PhoneNumber" style="color:red"></span>
    </div>

    <br />
    <button type="submit">Сохранить изменения</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}