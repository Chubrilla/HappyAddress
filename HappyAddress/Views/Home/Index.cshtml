@using System.Text.Json
@model HappyAddress.Models.AdFilterViewModel

@{
    var mapAdsJson = JsonSerializer.Serialize(
        (Model.Ads ?? Enumerable.Empty<HappyAddress.Models.Ad>())
            .Where(a => a.Latitude.HasValue && a.Longitude.HasValue)
            .Select(a => new
            {
                id = a.Id,
                title = a.Title,
                price = a.Price,
                city = a.City,
                address = a.Address,
                latitude = a.Latitude,
                longitude = a.Longitude
            }));
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster/dist/MarkerCluster.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster/dist/MarkerCluster.Default.css" />
}

<section class="hero-search">
    <div class="hero-search-content">
        <h1>Найдите недвижимость мечты</h1>
        <p>Покупка, аренда и посуточное жильё в одном сервисе</p>

        <form method="get" asp-action="Index" asp-controller="Home" class="hero-search-form">
            <input type="hidden" name="searchMode" id="searchMode" value="filters" />

            <div class="search-row">
                <div class="search-input-wrap">
                    <input type="text"
                           name="searchText"
                           value="@Model.SearchText"
                           class="main-search-input"
                           placeholder="Поиск: квартира, дом, район, адрес..." />

                    <button type="submit"
                            class="search-submit-btn"
                            title="Найти"
                            data-action="submit-text-search">
                        🔍
                    </button>
                </div>

                <div class="search-actions">
                    <button type="button" data-action="toggle-filters" class="filter-open-btn">
                        Фильтры
                    </button>

                    <button type="button" data-action="toggle-map" class="map-open-btn">
                        Объявления на карте
                    </button>
                </div>
            </div>
        </form>
    </div>
</section>

<div id="filtersModal" class="filters-modal">
    <form method="get" asp-action="Index" asp-controller="Home" class="filters-modal-content">
        <input type="hidden" name="searchMode" value="filters" />
        <input type="hidden" name="searchText" value="@Model.SearchText" />

        <div class="filters-modal-header">
            <h3>Фильтры</h3>

            <button type="button" class="filters-close-btn" data-action="toggle-filters">
                ×
            </button>
        </div>

        <div class="filter-grid">
            <div class="form-group">
                <label for="city">Город</label>
                <input id="city"
                       type="text"
                       name="city"
                       value="@Model.City"
                       placeholder="Например, Москва" />
            </div>

            <div class="form-group">
                <label for="dealType">Тип сделки</label>
                <select id="dealType" name="dealType">
                    <option value="">Все сделки</option>
                    <option value="Продажа" selected="@(Model.DealType == "Продажа")">
                        Продажа
                    </option>
                    <option value="Долгосрочная аренда" selected="@(Model.DealType == "Долгосрочная аренда")">
                        Долгосрочная аренда
                    </option>
                    <option value="Посуточная аренда" selected="@(Model.DealType == "Посуточная аренда")">
                        Посуточная аренда
                    </option>
                </select>
            </div>

            <div class="form-group">
                <label for="propertyType">Тип недвижимости</label>
                <select id="propertyType" name="propertyType">
                    <option value="">Вся недвижимость</option>
                    <option value="Квартира" selected="@(Model.PropertyType == "Квартира")">
                        Квартира
                    </option>
                    <option value="Дом" selected="@(Model.PropertyType == "Дом")">
                        Дом
                    </option>
                    <option value="Коттедж" selected="@(Model.PropertyType == "Коттедж")">
                        Коттедж
                    </option>
                    <option value="Таунхаус" selected="@(Model.PropertyType == "Таунхаус")">
                        Таунхаус
                    </option>
                    <option value="Участок" selected="@(Model.PropertyType == "Участок")">
                        Участок
                    </option>
                    <option value="Гараж" selected="@(Model.PropertyType == "Гараж")">
                        Гараж
                    </option>
                </select>
            </div>

            <div id="houseFilterFields" class="dynamic-filter-fields" style="display:none;">
