@model List<HappyAddress.Models.User>

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" />
}

<div class="admin-box">
    <h2>Пользователи</h2>

    @if (Model.Count == 0)
    {
        <p>Пользователей нет.</p>
    }
    else
    {
        <table class="admin-table">
            <tr>
                <th>ID</th>
                <th>Фамилия</th>
                <th>Имя</th>
                <th>Отчество</th>
                <th>Телефон</th>
                <th>Дата рождения</th>
                <th>Роль</th>
            </tr>

            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.LastName</td>
                    <td>@user.FirstName</td>
                    <td>@user.MiddleName</td>
                    <td>@user.PhoneNumber</td>
                    <td>@user.BirthDate.ToString("dd.MM.yyyy")</td>
                    <td>@user.Role</td>
                </tr>
            }
        </table>
    }
</div>