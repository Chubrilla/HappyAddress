@using Microsoft.AspNetCore.Http
@using System.Text.Json;

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HappyAddress</title>
   
    <link rel="stylesheet" href="~/css/layout.css" />
    <link rel="stylesheet" href="~/css/common.css" />

    @RenderSection("Styles", required: false)
</head>
<body>
    
    <div class="site-video-bg">
        <video autoplay muted loop playsinline>
            <source src="~/videos/city-bg.mp4" type="video/mp4" />
        </video>
    </div>

    <header class="main-header">
        <div class="container header-inner">
            <div class="logo-block">
                <a asp-controller="Home" asp-action="Index" class="logo">HappyAddress</a>
            </div>

            <nav class="main-nav">
                <a asp-controller="Home" asp-action="Index">Главная</a>

                @if (Context.Session.GetInt32("UserId") != null)
                {
                    @if (Context.Session.GetString("UserRole") == "Admin")
                    {
                        <a asp-controller="Admin" asp-action="Index">
                            Админка
                        </a>
                    }

                    <a asp-controller="Ads" asp-action="Favorites" class="favorites-header-link" title="Избранное">
                        ❤
                    </a>

                    <a asp-controller="Ads" asp-action="Create" class="new-ad-btn">
                        Новое объявление
                    </a>

                    <div class="user-dropdown">
                        <button type="button" class="user-dropdown-btn" onclick="toggleUserMenu()">
                            @Context.Session.GetString("UserName")
                            <span class="dropdown-arrow">▼</span>
                        </button>

                        <div id="userDropdownMenu" class="user-dropdown-menu">
                            <a asp-controller="Account" asp-action="Profile">
                                Профиль
                            </a>

                            <a asp-controller="Ads" asp-action="MyAds">
                                Мои объявления
                            </a>

                            <a asp-controller="Account" asp-action="Logout" class="dropdown-logout">
                                Выйти
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="nav-btn">
                        Войти
                    </a>

                    <a asp-controller="Account" asp-action="Register" class="nav-btn nav-btn-accent">
                        Регистрация
                    </a>
                }
            </nav>
        </div>
    </header>

    <main class="container main-content">

        <div id="toastContainer"></div>

        @if (TempData["Success"] != null)
        {
            <script>
                window.toastMessage = @Html.Raw(JsonSerializer.Serialize(TempData["Success"]));
                window.toastType = 'success';
            </script>
        }

        @if (TempData["Error"] != null)
        {
            <script>
                window.toastMessage = @Html.Raw(JsonSerializer.Serialize(TempData["Error"]));
                window.toastType = 'error';
            </script>
        }

        @RenderBody()
    </main>

    <script src="~/js/toast.js"></script>
    <script>
        function toggleUserMenu() {
            const menu = document.getElementById("userDropdownMenu");

            if (!menu) {
                return;
            }

            menu.classList.toggle("show");
        }

        document.addEventListener("click", function (event) {
            const dropdown = document.querySelector(".user-dropdown");

            if (!dropdown) {
                return;
            }

            if (!dropdown.contains(event.target)) {
                const menu = document.getElementById("userDropdownMenu");

                if (menu) {
                    menu.classList.remove("show");
                }
            }
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>