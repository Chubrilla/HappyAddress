@{
    ViewData["Title"] = "Подтверждение email";
}

<div class="auth-page">
    <div class="auth-card">
        <h2>Подтверждение email</h2>

        <p>
            Мы отправили код подтверждения на:
            <strong>@ViewBag.Email</strong>
        </p>

        <p style="color: #ff2626;">
            Если письмо не пришло в течение минуты, проверьте папку «Спам».
        </p>

        @if (TempData["Success"] != null)
        {
            <div class="success-message">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="error-message">
                @TempData["Error"]
            </div>
        }

        <form asp-action="ConfirmEmail" asp-controller="Account" method="post">
            <input type="hidden" name="email" value="@ViewBag.Email" />

            <div class="form-group">
                <label>Код подтверждения</label>
                <input type="text"
                       name="code"
                       maxlength="6"
                       placeholder="Введите 6-значный код" />
            </div>

            <div asp-validation-summary="All" class="error-message"></div>

            <button type="submit" class="auth-btn">
                Подтвердить email
            </button>
        </form>

        <form asp-action="ResendEmailCode" asp-controller="Account" method="post" style="margin-top: 14px;">
            <input type="hidden" name="email" value="@ViewBag.Email" />

            <button type="submit" class="secondary-btn">
                Отправить код повторно
            </button>
        </form>

        <div style="margin-top: 18px;">
            <a asp-action="Login" asp-controller="Account">
                Вернуться ко входу
            </a>
        </div>
    </div>
</div>