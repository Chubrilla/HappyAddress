@model IEnumerable<HappyAddress.Models.Ad>

@{
    ViewData["Title"] = "Избранное";
}

@section Styles {
    <link rel="stylesheet" href="~/css/ads.css" />
}

<section class="favorites-page">
    <div class="favorites-header">
        <h1>Избранные объявления</h1>
        <p>Здесь находятся объявления, которые вы добавили в избранное.</p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="favorites-empty">
            <h2>В избранном пока пусто</h2>
            <p>Добавляйте понравившиеся объявления, чтобы быстро вернуться к ним позже.</p>

            <a asp-controller="Home" asp-action="Index" class="favorites-main-btn">
                Перейти на главную
            </a>
        </div>
    }
    else
    {
        <div class="favorites-list">
            @foreach (var ad in Model)
            {
                <article class="favorite-card">
                    <a asp-controller="Ads"
                       asp-action="Details"
                       asp-route-id="@ad.Id"
                       class="favorite-card-image">

                        @if (ad.Images != null && ad.Images.Count > 0)
                        {
                            <img src="@ad.Images[0].ImagePath" alt="Фото объявления" />
                        }
                        else
                        {
                            <div class="favorite-no-image">
                                Нет фото
                            </div>
                        }
                    </a>

                    <div class="favorite-card-info">
                        <a asp-controller="Ads"
                           asp-action="Details"
                           asp-route-id="@ad.Id"
                           class="favorite-card-title">
                            @ad.Title
                        </a>

                        <div class="favorite-card-price">
                            @ad.Price.ToString("N0") ₽
                        </div>

                        <p>
                            <strong>Город:</strong>
                            @ad.City
                        </p>

                        <p>
                            <strong>Адрес:</strong>
                            @ad.Address
                        </p>

                        <p>
                            <strong>Тип:</strong>
                            @ad.PropertyType
                        </p>

                        <p>
                            <strong>Сделка:</strong>
                            @ad.DealType
                        </p>
                    </div>

                    <div class="favorite-card-actions">
                        <a asp-controller="Ads"
                           asp-action="Details"
                           asp-route-id="@ad.Id"
                           class="favorite-open-btn">
                            Подробнее
                        </a>

                        <form asp-controller="Ads"
                              asp-action="RemoveFromFavorites"
                              method="post">
                            <input type="hidden" name="adId" value="@ad.Id" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                            <button type="submit" class="favorite-remove-btn">
                                Удалить из избранного
                            </button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
</section>