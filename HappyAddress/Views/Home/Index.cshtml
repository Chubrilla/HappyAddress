                            <option value="">Любая</option>
                            <option value="Центральная" selected="@(Model.Sewerage == "Центральная")">Центральная</option>
                            <option value="Септик" selected="@(Model.Sewerage == "Септик")">Септик</option>
                            <option value="Выгребная яма" selected="@(Model.Sewerage == "Выгребная яма")">Выгребная яма</option>
                            <option value="Нет" selected="@(Model.Sewerage == "Нет")">Нет</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="waterSupply">Водоснабжение</label>
                        <select id="waterSupply" name="waterSupply">
                            <option value="">Любое</option>
                            <option value="Центральное" selected="@(Model.WaterSupply == "Центральное")">Центральное</option>
                            <option value="Скважина" selected="@(Model.WaterSupply == "Скважина")">Скважина</option>
                            <option value="Колодец" selected="@(Model.WaterSupply == "Колодец")">Колодец</option>
                            <option value="Нет" selected="@(Model.WaterSupply == "Нет")">Нет</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="gas">Газ</label>
                        <select id="gas" name="gas">
                            <option value="">Любой</option>
                            <option value="Магистральный в доме или на участке" selected="@(Model.Gas == "Магистральный в доме или на участке")">Магистральный</option>
                            <option value="По границе участка" selected="@(Model.Gas == "По границе участка")">По границе участка</option>
                            <option value="Газгольдер" selected="@(Model.Gas == "Газгольдер")">Газгольдер</option>
                            <option value="Нет" selected="@(Model.Gas == "Нет")">Нет</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="heating">Отопление</label>
                        <select id="heating" name="heating">
                            <option value="">Любое</option>
                            <option value="Центральное газовое" selected="@(Model.Heating == "Центральное газовое")">Центральное газовое</option>
                            <option value="Центральное угольное" selected="@(Model.Heating == "Центральное угольное")">Центральное угольное</option>
                            <option value="Печь" selected="@(Model.Heating == "Печь")">Печь</option>
                            <option value="Камин" selected="@(Model.Heating == "Камин")">Камин</option>
                            <option value="Электрическое" selected="@(Model.Heating == "Электрическое")">Электрическое</option>
                            <option value="Автономное газовое" selected="@(Model.Heating == "Автономное газовое")">Автономное газовое</option>
                            <option value="Дизельное" selected="@(Model.Heating == "Дизельное")">Дизельное</option>
                            <option value="Твердотопливный котёл" selected="@(Model.Heating == "Твердотопливный котёл")">Твердотопливный котёл</option>
                            <option value="Без отопления" selected="@(Model.Heating == "Без отопления")">Без отопления</option>
                        </select>
                    </div>
                </div>

                <h4>Удобства</h4>

                <div class="filter-checkboxes">
                    <label>
                        <input type="checkbox" name="hasGarage" value="true" checked="@Model.HasGarage" />
                        Гараж
                    </label>

                    <label>
                        <input type="checkbox" name="hasTerrace" value="true" checked="@Model.HasTerrace" />
                        Терраса
                    </label>

                    <label>
                        <input type="checkbox" name="hasPool" value="true" checked="@Model.HasPool" />
                        Бассейн
                    </label>

                    <label>
                        <input type="checkbox" name="hasBathhouse" value="true" checked="@Model.HasBathhouse" />
                        Баня
                    </label>

                    <label>
                        <input type="checkbox" name="hasSecurity" value="true" checked="@Model.HasSecurity" />
                        Охрана
                    </label>
                </div>
            </div>

            <div id="flatFilterFields" class="dynamic-filter-fields" style="display:none;">
                <h4>Параметры квартиры</h4>

                <div class="filter-grid">
                    <div class="form-group">
                        <label for="roomsFilter">Количество комнат</label>
                        <select id="roomsFilter" name="roomsFilter">
                            <option value="">Любое</option>
                            <option value="studio" selected="@(Model.RoomsFilter == "studio")">Студия</option>
                            <option value="1" selected="@(Model.RoomsFilter == "1")">1 комната</option>
                            <option value="2" selected="@(Model.RoomsFilter == "2")">2 комнаты</option>
                            <option value="3" selected="@(Model.RoomsFilter == "3")">3 комнаты</option>
                            <option value="4" selected="@(Model.RoomsFilter == "4")">4 комнаты</option>
                            <option value="5plus" selected="@(Model.RoomsFilter == "5plus")">5+ комнат</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="floorFrom">Этаж от</label>
                        <input id="floorFrom"
                               type="number"
                               min="0"
                               name="floorFrom"
                               value="@Model.FloorFrom"
                               placeholder="1" />
                    </div>

                    <div class="form-group">
                        <label for="floorTo">Этаж до</label>
                        <input id="floorTo"
                               type="number"
                               min="0"
                               name="floorTo"
                               value="@Model.FloorTo"
                               placeholder="20" />
                    </div>

                    <div class="form-group">
                        <label for="livingAreaFrom">Жилая площадь от, м²</label>
                        <input id="livingAreaFrom"
                               type="number"
                               step="0.1"
                               min="0"
                               name="livingAreaFrom"
                               value="@Model.LivingAreaFrom"
                               placeholder="20" />
                    </div>

                    <div class="form-group">
                        <label for="livingAreaTo">Жилая площадь до, м²</label>
                        <input id="livingAreaTo"
                               type="number"
                               step="0.1"
                               min="0"
                               name="livingAreaTo"
                               value="@Model.LivingAreaTo"
                               placeholder="100" />
                    </div>

                    <div class="form-group">
                        <label for="kitchenAreaFrom">Площадь кухни от, м²</label>
                        <input id="kitchenAreaFrom"
                               type="number"
                               step="0.1"
                               min="0"
                               name="kitchenAreaFrom"
                               value="@Model.KitchenAreaFrom"
                               placeholder="6" />
                    </div>

                    <div class="form-group">
                        <label for="kitchenAreaTo">Площадь кухни до, м²</label>
                        <input id="kitchenAreaTo"
                               type="number"
                               step="0.1"
                               min="0"
                               name="kitchenAreaTo"
                               value="@Model.KitchenAreaTo"
                               placeholder="30" />
                    </div>

                    <div class="form-group">
                        <label for="renovation">Ремонт</label>
                        <select id="renovation" name="renovation">
                            <option value="">Любой</option>
                            <option value="Без ремонта" selected="@(Model.Renovation == "Без ремонта")">Без ремонта</option>
                            <option value="Косметический" selected="@(Model.Renovation == "Косметический")">Косметический</option>
                            <option value="Евроремонт" selected="@(Model.Renovation == "Евроремонт")">Евроремонт</option>
                            <option value="Дизайнерский" selected="@(Model.Renovation == "Дизайнерский")">Дизайнерский</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="buildingType">Тип дома</label>
                        <select id="buildingType" name="buildingType">
                            <option value="">Любой</option>
                            <option value="Кирпичный" selected="@(Model.BuildingType == "Кирпичный")">Кирпичный</option>
                            <option value="Монолитный" selected="@(Model.BuildingType == "Монолитный")">Монолитный</option>
                            <option value="Панельный" selected="@(Model.BuildingType == "Панельный")">Панельный</option>
                            <option value="Блочный" selected="@(Model.BuildingType == "Блочный")">Блочный</option>
                            <option value="Деревянный" selected="@(Model.BuildingType == "Деревянный")">Деревянный</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="bathroomType">Санузел</label>
                        <select id="bathroomType" name="bathroomType">
                            <option value="">Любой</option>
                            <option value="Совмещенный" selected="@(Model.BathroomType == "Совмещенный")">Совмещенный</option>
                            <option value="Раздельный" selected="@(Model.BathroomType == "Раздельный")">Раздельный</option>
                            <option value="Несколько" selected="@(Model.BathroomType == "Несколько")">Несколько</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="balconyType">Балкон / лоджия</label>
                        <select id="balconyType" name="balconyType">
                            <option value="">Не важно</option>
                            <option value="Балкон" selected="@(Model.BalconyType == "Балкон")">Балкон</option>
                            <option value="Лоджия" selected="@(Model.BalconyType == "Лоджия")">Лоджия</option>
                            <option value="Балкон и лоджия" selected="@(Model.BalconyType == "Балкон и лоджия")">Балкон и лоджия</option>
                            <option value="Нет" selected="@(Model.BalconyType == "Нет")">Нет</option>
                        </select>
                    </div>
                </div>

                <h4>Дополнительно</h4>

                <div class="filter-checkboxes">
                    <label>
                        <input type="checkbox" name="hasElevator" value="true" checked="@Model.HasElevator" />
                        Лифт
                    </label>

                    <label>
                        <input type="checkbox" name="hasParking" value="true" checked="@Model.HasParking" />
                        Парковка
                    </label>
                </div>
            </div>

            <div id="landFilterFields" class="dynamic-filter-fields" style="display:none;">
                <h4>Параметры участка</h4>

                <div class="filter-grid">
                    <div class="form-group">
                        <label for="landAreaFrom">Площадь участка от, сот.</label>
                        <input id="landAreaFrom"
                               type="number"
                               step="0.1"
                               min="0"
                               name="landAreaFrom"
                               value="@Model.LandAreaFrom"
                               placeholder="Например, 6" />
                    </div>

                    <div class="form-group">
                        <label for="landAreaTo">Площадь участка до, сот.</label>
                        <input id="landAreaTo"
                               type="number"
                               step="0.1"
                               min="0"
                               name="landAreaTo"
                               value="@Model.LandAreaTo"
                               placeholder="Например, 20" />
                    </div>

                    <div class="form-group">
                        <label for="landCategory">Категория земли</label>
                        <select id="landCategory" name="landCategory">
                            <option value="">Любая</option>
                            <option value="ИЖС" selected="@(Model.LandCategory == "ИЖС")">ИЖС</option>
                            <option value="СНТ" selected="@(Model.LandCategory == "СНТ")">СНТ</option>
                            <option value="ДНП" selected="@(Model.LandCategory == "ДНП")">ДНП</option>
                            <option value="ЛПХ" selected="@(Model.LandCategory == "ЛПХ")">ЛПХ</option>
                            <option value="Фермерское хозяйство" selected="@(Model.LandCategory == "Фермерское хозяйство")">Фермерское хозяйство</option>
                            <option value="Промназначение" selected="@(Model.LandCategory == "Промназначение")">Промназначение</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="landStatus">Статус участка</label>
                        <select id="landStatus" name="landStatus">
                            <option value="">Любой</option>
                            <option value="В собственности" selected="@(Model.LandStatus == "В собственности")">В собственности</option>
                            <option value="В аренде" selected="@(Model.LandStatus == "В аренде")">В аренде</option>
                            <option value="Документы готовы" selected="@(Model.LandStatus == "Документы готовы")">Документы готовы</option>
                            <option value="Требуется оформление" selected="@(Model.LandStatus == "Требуется оформление")">Требуется оформление</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="electricity">Электричество</label>
                        <select id="electricity" name="electricity">
                            <option value="">Любое</option>
                            <option value="Есть" selected="@(Model.Electricity == "Есть")">Есть</option>
                            <option value="Нет" selected="@(Model.Electricity == "Нет")">Нет</option>
                        </select>
                    </div>
                </div>
            </div>

            <div id="garageFilterFields" class="dynamic-filter-fields" style="display:none;">
                <h4>Параметры гаража</h4>

                <div class="filter-grid">
                    <div class="form-group">
                        <label for="garageType">Тип гаража</label>
                        <select id="garageType" name="garageType">
                            <option value="">Любой</option>
                            <option value="Гараж" selected="@(Model.GarageType == "Гараж")">Гараж</option>
                            <option value="Машино-место" selected="@(Model.GarageType == "Машино-место")">Машино-место</option>
                            <option value="Бокс" selected="@(Model.GarageType == "Бокс")">Бокс</option>
                            <option value="Подземный паркинг" selected="@(Model.GarageType == "Подземный паркинг")">Подземный паркинг</option>
                            <option value="Многоуровневый паркинг" selected="@(Model.GarageType == "Многоуровневый паркинг")">Многоуровневый паркинг</option>
                            <option value="Открытая парковка" selected="@(Model.GarageType == "Открытая парковка")">Открытая парковка</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="garageStatus">Статус</label>
                        <select id="garageStatus" name="garageStatus">
                            <option value="">Любой</option>
                            <option value="В собственности" selected="@(Model.GarageStatus == "В собственности")">В собственности</option>
                            <option value="В аренде" selected="@(Model.GarageStatus == "В аренде")">В аренде</option>
                            <option value="ГСК" selected="@(Model.GarageStatus == "ГСК")">ГСК</option>
                            <option value="Документы готовы" selected="@(Model.GarageStatus == "Документы готовы")">Документы готовы</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="garageAreaFrom">Площадь от, м²</label>
                        <input id="garageAreaFrom"
                               type="number"
                               step="0.1"
                               min="0"
                               name="totalAreaFrom"
                               value="@Model.TotalAreaFrom"
                               placeholder="Например, 15" />
                    </div>

                    <div class="form-group">
                        <label for="garageAreaTo">Площадь до, м²</label>
                        <input id="garageAreaTo"
                               type="number"
                               step="0.1"
                               min="0"
                               name="totalAreaTo"
                               value="@Model.TotalAreaTo"
                               placeholder="Например, 40" />
                    </div>

                    <div class="form-group">
                        <label for="garageElectricity">Электричество</label>
                        <select id="garageElectricity" name="electricity">
                            <option value="">Любое</option>
                            <option value="Есть" selected="@(Model.Electricity == "Есть")">Есть</option>
                            <option value="Нет" selected="@(Model.Electricity == "Нет")">Нет</option>
                        </select>
                    </div>
                </div>

                <h4>Дополнительно</h4>

                <div class="filter-checkboxes">
                    <label>
                        <input type="checkbox" name="hasSecurity" value="true" checked="@Model.HasSecurity" />
                        Охрана
                    </label>
                </div>
            </div>

            <div id="dailyRentFilterFields" class="dynamic-filter-fields" style="display:none;">
                <h4>Посуточная аренда</h4>

                <div class="filter-grid">
                    <div class="form-group">
                        <label for="guestsCountFrom">Гостей от</label>
                        <input id="guestsCountFrom"
                               type="number"
                               min="1"
                               name="guestsCountFrom"
                               value="@Model.GuestsCountFrom"
                               placeholder="Например, 2" />
                    </div>

                    <div class="form-group">
                        <label for="sleepingPlacesFrom">Спальных мест от</label>
                        <input id="sleepingPlacesFrom"
                               type="number"
                               min="1"
                               name="sleepingPlacesFrom"
                               value="@Model.SleepingPlacesFrom"
                               placeholder="Например, 2" />
                    </div>

                    <div class="form-group">
                        <label for="availableFrom">Дата заезда</label>
                        <input id="availableFrom"
                               type="date"
                               name="availableFrom"
                               value="@(Model.AvailableFrom.HasValue ? Model.AvailableFrom.Value.ToString("yyyy-MM-dd") : "")" />
                    </div>

                    <div class="form-group">
                        <label for="availableTo">Дата выезда</label>
                        <input id="availableTo"
                               type="date"
                               name="availableTo"
                               value="@(Model.AvailableTo.HasValue ? Model.AvailableTo.Value.ToString("yyyy-MM-dd") : "")" />
                    </div>
                </div>

                <h4>Удобства</h4>

                <div class="filter-checkboxes">
                    <label><input type="checkbox" name="hasWifi" value="true" checked="@Model.HasWifi" /> Wi-Fi</label>
                    <label><input type="checkbox" name="hasAirConditioner" value="true" checked="@Model.HasAirConditioner" /> Кондиционер</label>
                    <label><input type="checkbox" name="hasKitchen" value="true" checked="@Model.HasKitchen" /> Кухня</label>
                    <label><input type="checkbox" name="hasTv" value="true" checked="@Model.HasTv" /> Телевизор</label>
                    <label><input type="checkbox" name="hasWashingMachine" value="true" checked="@Model.HasWashingMachine" /> Стиральная машина</label>
                    <label><input type="checkbox" name="hasBedLinen" value="true" checked="@Model.HasBedLinen" /> Постельное бельё</label>
                    <label><input type="checkbox" name="hasFurniture" value="true" checked="@Model.HasFurniture" /> Мебель</label>
                    <label><input type="checkbox" name="hasAppliances" value="true" checked="@Model.HasAppliances" /> Техника</label>
                    <label><input type="checkbox" name="allowChildren" value="true" checked="@Model.AllowChildren" /> Можно с детьми</label>
                    <label><input type="checkbox" name="allowPets" value="true" checked="@Model.AllowPets" /> Можно с животными</label>
                </div>
            </div>

            <div id="longRentFilterFields" class="dynamic-filter-fields" style="display:none;">
                <h4>Долгосрочная аренда</h4>

                <div class="filter-grid">
                    <div class="form-group">
                        <label for="depositFrom">Залог от, ₽</label>
                        <input id="depositFrom"
                               type="number"
                               min="0"
                               name="depositFrom"
                               value="@Model.DepositFrom"
                               placeholder="Например, 10000" />
                    </div>

                    <div class="form-group">
                        <label for="depositTo">Залог до, ₽</label>
                        <input id="depositTo"
                               type="number"
                               min="0"
                               name="depositTo"
                               value="@Model.DepositTo"
                               placeholder="Например, 50000" />
                    </div>

                    <div class="form-group">
                        <label for="prepayment">Предоплата</label>
                        <select id="prepayment" name="prepayment">
                            <option value="">Любая</option>
                            <option value="1 месяц" selected="@(Model.Prepayment == "1 месяц")">1 месяц</option>
                            <option value="2 месяца" selected="@(Model.Prepayment == "2 месяца")">2 месяца</option>
                            <option value="3 месяца" selected="@(Model.Prepayment == "3 месяца")">3 месяца</option>
                            <option value="Без предоплаты" selected="@(Model.Prepayment == "Без предоплаты")">Без предоплаты</option>
                        </select>
                    </div>
                </div>

                <h4>Условия проживания</h4>

                <div class="filter-checkboxes">
                    <label>
                        <input type="checkbox" name="allowChildren" value="true" checked="@Model.AllowChildren" />
                        Можно с детьми
                    </label>

                    <label>
                        <input type="checkbox" name="allowPets" value="true" checked="@Model.AllowPets" />
                        Можно с животными
                    </label>

                    <label>
                        <input type="checkbox" name="hasFurniture" value="true" checked="@Model.HasFurniture" />
                        Мебель
                    </label>

                    <label>
                        <input type="checkbox" name="hasAppliances" value="true" checked="@Model.HasAppliances" />
                        Техника
                    </label>
                </div>
            </div>

            <div class="form-group">
                <label for="priceFrom">Цена от</label>
                <input id="priceFrom"
                       type="number"
                       name="priceFrom"
                       value="@Model.PriceFrom"
                       min="0"
                       placeholder="0" />
            </div>

            <div class="form-group">
                <label for="priceTo">Цена до</label>
                <input id="priceTo"
                       type="number"
                       name="priceTo"
                       value="@Model.PriceTo"
                       min="0"
                       placeholder="10000000" />
            </div>

            <div class="form-group">
                <label for="sortBy">Сортировка</label>
                <select id="sortBy" name="sortBy">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.SortBy))">
                        Сначала новые
                    </option>

                    <option value="date_old" selected="@(Model.SortBy == "date_old")">
                        Сначала старые
                    </option>

                    <option value="price_asc" selected="@(Model.SortBy == "price_asc")">
                        Сначала дешёвые
                    </option>

                    <option value="price_desc" selected="@(Model.SortBy == "price_desc")">
                        Сначала дорогие
                    </option>
                </select>
            </div>
        </div>

        <div class="filters-actions">
            <button type="submit" class="apply-filter-btn">
                Применить фильтры
            </button>

            <a asp-controller="Home"
               asp-action="Index"
               class="reset-filter-btn">
                Сбросить фильтры
            </a>
        </div>
    </form>
</div>

<section id="homeMapBox" class="home-map-box" style="display: none;" data-map-ads="@mapAdsJson">
    <div class="map-header">
        <div>
            <h3>Объявления на карте</h3>
            <p>На карте отображаются объявления из текущей выдачи.</p>
        </div>

        <button type="button" class="map-close-btn" data-action="toggle-map">
            Закрыть карту
        </button>
    </div>

    <div id="adsMap" style="width: 100%; height: 520px; border-radius: 18px;"></div>

    <div id="clusterAdsList" class="cluster-ads-list" style="display: none;">
        <h4>Объявления в выбранной области</h4>
        <div id="clusterAdsItems"></div>
    </div>
</section>

<section class="ads-section">
    <div class="ads-section-header">
        <div>
            <h2>Список объявлений</h2>
            <p>Найдено объявлений: @Model.TotalAds</p>
        </div>
    </div>

    @if (Model.Ads == null || !Model.Ads.Any())
    {
        <div class="ads-empty-box">
            <p>Объявления не найдены.</p>
        </div>
    }
    else
    {
        <div class="ads-grid">
            @foreach (var ad in Model.Ads)
            {
                string statusClass = "ad-status-default";

                if (ad.Status == "Опубликовано")
                {
                    statusClass = "ad-status-published";
                }
                else if (ad.Status == "На модерации")
                {
                    statusClass = "ad-status-moderation";
                }
                else if (ad.Status == "Отклонено")
                {
                    statusClass = "ad-status-rejected";
                }

                <article class="ad-tile">
                    <a asp-controller="Ads"
                       asp-action="Details"
                       asp-route-id="@ad.Id"
                       class="ad-tile-image-link">

                        <div class="ad-tile-image">
                            @if (ad.Images != null && ad.Images.Count > 0)
                            {
                                <img src="@ad.Images[0].ImagePath" alt="Фото объявления" />
                            }
                            else
                            {
                                <div class="ad-tile-no-image">
                                    Нет фото
                                </div>
                            }
                        </div>
                    </a>

                    <div class="ad-tile-body">
                        <a asp-controller="Ads"
                           asp-action="Details"
                           asp-route-id="@ad.Id"
                           class="ad-tile-title">
                            @ad.Title
                        </a>

                        <div class="ad-tile-price">
                            @ad.Price.ToString("N0") ₽
                        </div>

                        <div class="ad-tile-meta">
                            @ad.PropertyType · @ad.DealType
                        </div>

                        <div class="ad-tile-address">
                            @ad.City

                            @if (!string.IsNullOrWhiteSpace(ad.Address))
                            {
                                <span>, @ad.Address</span>
                            }
                        </div>

                        <div class="ad-tile-footer">
                            <span class="ad-tile-status @statusClass">
                                @ad.Status
                            </span>

                            <a asp-controller="Ads"
                               asp-action="Details"
                               asp-route-id="@ad.Id"
                               class="ad-tile-details">
                                Подробнее
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <div class="pagination">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                if (i == Model.CurrentPage)
                {
                    <strong>@i</strong>
                }
                else
                {
                    <a asp-action="Index"
                       asp-route-page="@i"
                       asp-route-searchText="@Model.SearchText"
                       asp-route-city="@Model.City"
                       asp-route-dealType="@Model.DealType"
                       asp-route-propertyType="@Model.PropertyType"
                       asp-route-priceFrom="@Model.PriceFrom"
                       asp-route-priceTo="@Model.PriceTo"
                       asp-route-sortBy="@Model.SortBy">
                        @i
                    </a>
                }
            }
        </div>
    }
</section>

@section Scripts {
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet.markercluster/dist/leaflet.markercluster.js"></script>
    <script src="~/js/home-index.js" asp-append-version="true"></script>
}
