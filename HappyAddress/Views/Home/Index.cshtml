                <div class="filter-grid">
                    <div class="form-group">
                        <label for="totalAreaFrom">Площадь дома от, м²</label>
                        <input id="totalAreaFrom"
                               type="number"
                               step="0.1"
                               min="0"
                               name="totalAreaFrom"
                               value="@Model.TotalAreaFrom"
                               placeholder="Например, 80" />
                    </div>

                    <div class="form-group">
                        <label for="totalAreaTo">Площадь дома до, м²</label>
                        <input id="totalAreaTo"
                               type="number"
                               step="0.1"
                               min="0"
                               name="totalAreaTo"
                               value="@Model.TotalAreaTo"
                               placeholder="Например, 300" />
                    </div>

                    <div class="form-group">
                        <label for="bedroomsFrom">Спален от</label>
                        <input id="bedroomsFrom"
                               type="number"
                               min="0"
                               name="bedroomsFrom"
                               value="@Model.BedroomsFrom"
                               placeholder="1" />
                    </div>

                    <div class="form-group">
                        <label for="bedroomsTo">Спален до</label>
                        <input id="bedroomsTo"
                               type="number"
                               min="0"
                               name="bedroomsTo"
                               value="@Model.BedroomsTo"
                               placeholder="5" />
                    </div>

                    <div class="form-group">
                        <label for="totalFloorsFrom">Этажей от</label>
                        <input id="totalFloorsFrom"
                               type="number"
                               min="0"
                               name="totalFloorsFrom"
                               value="@Model.TotalFloorsFrom"
                               placeholder="1" />
                    </div>

                    <div class="form-group">
                        <label for="totalFloorsTo">Этажей до</label>
                        <input id="totalFloorsTo"
                               type="number"
                               min="0"
                               name="totalFloorsTo"
                               value="@Model.TotalFloorsTo"
                               placeholder="3" />
                    </div>

                    <div class="form-group">
                        <label for="buildYearFrom">Год постройки от</label>
                        <input id="buildYearFrom"
                               type="number"
                               min="1800"
                               max="2100"
                               name="buildYearFrom"
                               value="@Model.BuildYearFrom"
                               placeholder="2000" />
                    </div>

                    <div class="form-group">
                        <label for="buildYearTo">Год постройки до</label>
                        <input id="buildYearTo"
                               type="number"
                               min="1800"
                               max="2100"
                               name="buildYearTo"
                               value="@Model.BuildYearTo"
                               placeholder="2026" />
                    </div>

                    <div class="form-group">
                        <label for="houseMaterial">Материал дома</label>
                        <select id="houseMaterial" name="houseMaterial">
                            <option value="">Любой</option>
                            <option value="Кирпичный" selected="@(Model.HouseMaterial == "Кирпичный")">Кирпичный</option>
                            <option value="Монолитный" selected="@(Model.HouseMaterial == "Монолитный")">Монолитный</option>
                            <option value="Деревянный" selected="@(Model.HouseMaterial == "Деревянный")">Деревянный</option>
                            <option value="Щитовой" selected="@(Model.HouseMaterial == "Щитовой")">Щитовой</option>
                            <option value="Каркасный" selected="@(Model.HouseMaterial == "Каркасный")">Каркасный</option>
                            <option value="Блочный" selected="@(Model.HouseMaterial == "Блочный")">Блочный</option>
                            <option value="Газобетонный блок" selected="@(Model.HouseMaterial == "Газобетонный блок")">Газобетонный блок</option>
                            <option value="Газосиликатный блок" selected="@(Model.HouseMaterial == "Газосиликатный блок")">Газосиликатный блок</option>
                            <option value="Пенобетонный блок" selected="@(Model.HouseMaterial == "Пенобетонный блок")">Пенобетонный блок</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="houseCondition">Состояние дома</label>
                        <select id="houseCondition" name="houseCondition">
                            <option value="">Любое</option>
                            <option value="Можно жить" selected="@(Model.HouseCondition == "Можно жить")">Можно жить</option>
                            <option value="Нужен ремонт" selected="@(Model.HouseCondition == "Нужен ремонт")">Нужен ремонт</option>
                            <option value="Нужно достроить" selected="@(Model.HouseCondition == "Нужно достроить")">Нужно достроить</option>
                            <option value="Нужен капремонт или под снос" selected="@(Model.HouseCondition == "Нужен капремонт или под снос")">Нужен капремонт или под снос</option>
                        </select>
