@model HappyAddress.Models.RegisterViewModel

@{
    ViewData["Title"] = "Регистрация";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" />
}

<div class="auth-page register-auth-page">
    <div class="auth-card register-auth-card">
        <h1>Регистрация</h1>

        @if (TempData["Error"] != null)
        {
            <div class="error-message">
                @TempData["Error"]
            </div>
        }

        <form asp-action="Register" asp-controller="Account" method="post">
            <div class="auth-form-row">
                <div class="form-group">
                    <label asp-for="LastName">Фамилия</label>
                    <input asp-for="LastName" placeholder="Введите фамилию" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="FirstName">Имя</label>
                    <input asp-for="FirstName" placeholder="Введите имя" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
            </div>

            <div class="auth-form-row">
                <div class="form-group">
                    <label asp-for="MiddleName">Отчество</label>
                    <input asp-for="MiddleName" placeholder="Введите отчество" />
                    <span asp-validation-for="MiddleName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="BirthDate">Дата рождения</label>
                    <input type="text"
                           id="BirthDateDisplay"
                           inputmode="numeric"
                           maxlength="10"
                           autocomplete="bday"
                           placeholder="ДД.ММ.ГГГГ"
                           value="@(Model != null && Model.BirthDate != default ? Model.BirthDate.ToString("dd.MM.yyyy") : "")" />
                    <input type="hidden"
                           id="BirthDate"
                           name="BirthDate"
                           value="@(Model != null && Model.BirthDate != default ? Model.BirthDate.ToString("yyyy-MM-dd") : "")" />
                    <span asp-validation-for="BirthDate" class="text-danger"></span>
                </div>
            </div>

            <div class="auth-form-row">
                <div class="form-group">
                    <label asp-for="PhoneNumber">Телефон</label>
                    <input asp-for="PhoneNumber" placeholder="+7 (999) 123-45-67" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" type="email" placeholder="Введите email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <div class="auth-form-row">
                <div class="form-group">
                    <label asp-for="Password">Пароль</label>
                    <input asp-for="Password" type="password" placeholder="Введите пароль" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword">Повторите пароль</label>
                    <input asp-for="ConfirmPassword" type="password" placeholder="Повторите пароль" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>

            <div asp-validation-summary="All" class="text-danger"></div>

            <button type="submit" class="auth-btn">
                Зарегистрироваться
            </button>
        </form>

        <div class="auth-bottom-text">
            Уже есть аккаунт?
            <a asp-controller="Account" asp-action="Login">
                Войти
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/phone-format.js" asp-append-version="true"></script>
    <script src="~/js/account-register.js" asp-append-version="true"></script>
}
