@model List<HappyAddress.Models.Ad>

@{
    ViewData["Title"] = "Мои объявления";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" />
    <link rel="stylesheet" href="~/css/ads.css" />
}

<div class="profile-page">
    <div class="profile-layout">

        <aside class="profile-sidebar">
            <h2>Личный кабинет</h2>

            <nav class="profile-menu">
                <a asp-controller="Account" asp-action="Profile">
                    Профиль
                </a>

                <a asp-controller="Ads" asp-action="MyAds" class="active">
                    Мои объявления
                </a>

                <a asp-controller="Account" asp-action="Logout" class="logout-link">
                    Выйти
                </a>
            </nav>
        </aside>

        <main class="profile-content">
            <div class="profile-card">

                <div class="profile-card-header">
                    <div>
                        <h1>Мои объявления</h1>
                        <p>Здесь отображаются объявления, которые вы создали.</p>
                    </div>
                </div>

                @if (Model.Count == 0)
                {
                    <div class="ads-empty-box">
                        <p>У вас пока нет объявлений.</p>

                        <a asp-controller="Ads" asp-action="Create" class="profile-create-ad-btn">
                            Создать первое объявление
                        </a>
                    </div>
                }
                else
                {
                    <div class="profile-myads-list">
                        @foreach (var ad in Model)
                        {
                            string statusClass = "";

                            if (ad.Status == "На модерации")
                            {
                                statusClass = "status-orange";
                            }
                            else if (ad.Status == "Опубликовано")
                            {
                                statusClass = "status-green";
                            }
                            else if (ad.Status == "Отклонено")
                            {
                                statusClass = "status-red";
                            }

                            <div class="profile-myads-card">
                                <div class="profile-myads-image">
                                    @if (ad.Images != null && ad.Images.Count > 0)
                                    {
                                        <img src="@ad.Images[0].ImagePath" alt="Фото объявления" />
                                    }
                                    else
                                    {
                                        <span>Нет фото</span>
                                    }
                                </div>

                                <div class="profile-myads-info">
                                    <h3>
                                        <a asp-controller="Ads" asp-action="Details" asp-route-id="@ad.Id">
                                            @ad.Title
                                        </a>
                                    </h3>

                                    <p class="profile-myads-price">
                                        @ad.Price.ToString("N0") ₽
                                    </p>

                                    <p>
                                        <strong>Город:</strong> @ad.City
                                    </p>

                                    <p>
                                        <strong>Адрес:</strong> @ad.Address
                                    </p>

                                    <p>
                                        <strong>Тип:</strong> @ad.PropertyType
                                    </p>

                                    <p>
                                        <strong>Сделка:</strong> @ad.DealType
                                    </p>

                                    <p>
                                        <strong>Статус:</strong>
                                        <span class="@statusClass">@ad.Status</span>
                                    </p>

                                    @if (!string.IsNullOrEmpty(ad.RejectReason))
                                    {
                                        <p>
                                            <strong>Причина отклонения:</strong> @ad.RejectReason
                                        </p>
                                    }

                                    <p>
                                        <strong>Дата:</strong> @ad.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                    </p>
                                </div>

                                <div class="profile-myads-actions">
                                    <a asp-controller="Ads" asp-action="Details" asp-route-id="@ad.Id">
                                        Подробнее
                                    </a>

                                    <a asp-controller="Ads" asp-action="Edit" asp-route-id="@ad.Id">
                                        Редактировать
                                    </a>

                                    <form asp-controller="Ads"
                                          asp-action="Delete"
                                          method="post"
                                          onsubmit="return confirm('Удалить объявление?');">
                                        <input type="hidden" name="id" value="@ad.Id" />
                                        <button type="submit">
                                            Удалить
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>

                    @if (ViewBag.TotalPages > 1)
                    {
                        <div class="pagination">
                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                if (i == ViewBag.CurrentPage)
                                {
                                    <strong>@i</strong>
                                }
                                else
                                {
                                    <a asp-controller="Ads" asp-action="MyAds" asp-route-page="@i">@i</a>
                                }
                            }
                        </div>
                    }
                }

            </div>
        </main>

    </div>
</div>