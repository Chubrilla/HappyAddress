@using Microsoft.AspNetCore.Http
@inject HappyAddress.Data.AppDbContext DbContext

@{
    int? currentUserId = Context.Session.GetInt32("UserId");
    string? currentUserName = Context.Session.GetString("UserName");
    string? currentUserAvatarPath = Context.Session.GetString("UserAvatarPath");

    int unreadMessagesCount = 0;
    string? toastMessage = TempData["Success"]?.ToString() ?? TempData["Error"]?.ToString();
    string? toastType = TempData["Error"] != null ? "error" : (TempData["Success"] != null ? "success" : null);

    if (currentUserId != null)
    {
        unreadMessagesCount = DbContext.ChatMessages.Count(m =>
            m.SenderUserId != currentUserId.Value &&
            !m.IsRead &&
            (m.Chat.BuyerUserId == currentUserId.Value ||
             m.Chat.SellerUserId == currentUserId.Value));
    }

    string avatarLetter = "П";

    if (!string.IsNullOrWhiteSpace(currentUserName))
    {
        avatarLetter = currentUserName.Trim().Substring(0, 1).ToUpper();
    }
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HappyAddress</title>

    <link rel="stylesheet" href="~/css/layout.css" />
    <link rel="stylesheet" href="~/css/common.css" />

    @RenderSection("Styles", required: false)

    <link rel="stylesheet" href="~/css/site-polish.css" asp-append-version="true" />
</head>

<body>

    <div class="site-video-bg">
        <video autoplay muted loop playsinline>
            <source src="~/videos/city-bg.mp4" type="video/mp4" />
        </video>
    </div>

    <header class="main-header">
        <div class="container header-inner">
            <div class="logo-block">
                <a asp-controller="Home" asp-action="Index" class="logo">
                    HappyAddress
                </a>
            </div>

            <nav class="main-nav">
                <a asp-controller="Home" asp-action="Index">
                    Главная
                </a>

                @if (currentUserId != null)
                {
                    @if (Context.Session.GetString("UserRole") == "Admin")
                    {
                        <a asp-controller="Admin" asp-action="Index">
                            Админка
                        </a>
                    }

                    <a asp-controller="Ads"
                       asp-action="Favorites"
                       class="favorites-header-link"
                       title="Избранное">
                        ❤
                    </a>

                    <a asp-controller="Ads"
                       asp-action="Create"
                       class="new-ad-btn">
                        Новое объявление
                    </a>

                    <a asp-controller="Users"
                       asp-action="Profile"
                       asp-route-id="@currentUserId.Value"
                       class="header-profile-link">

                        <span class="header-profile-avatar">
                            @if (!string.IsNullOrWhiteSpace(currentUserAvatarPath))
                            {
                                <img src="@currentUserAvatarPath" alt="Аватар" />
                            }
                            else
                            {
                                @avatarLetter
                            }
                        </span>

                        <span class="header-profile-name">
                            @currentUserName
                        </span>
                    </a>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="nav-btn">
                        Войти
                    </a>

                    <a asp-controller="Account"
                       asp-action="Register"
                       class="nav-btn nav-btn-accent">
                        Регистрация
                    </a>
                }
            </nav>
        </div>
    </header>

    <main class="container main-content">

        <div id="toastContainer"
             data-toast-message="@toastMessage"
             data-toast-type="@toastType"></div>

        @RenderBody()
    </main>

    @if (currentUserId != null)
    {
        <a asp-controller="Chat"
           asp-action="Index"
           class="floating-chat-btn"
           title="Сообщения">

            <span class="floating-chat-icon">💬</span>

            @if (unreadMessagesCount > 0)
            {
                <span class="floating-chat-badge">
                    @unreadMessagesCount
                </span>
            }
        </a>
    }

    <script src="~/js/toast.js"></script>
    <script src="~/js/confirm-submit.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
